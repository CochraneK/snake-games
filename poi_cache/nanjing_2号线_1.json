:"stone","memorial":"stele","name":"百年树人碑"}},{"type":"node","id":11656779069,"lat":32.049575,"lon":118.7523341,"tags":{"name":"南京城墙清凉门","tourism":"artwork"}},{"type":"node","id":11868442872,"lat":32.0037351,"lon":118.7766787,"tags":{"historic":"yes","name":"江南第二泉","natural":"spring"}},{"type":"node","id":11909645746,"lat":32.000172,"lon":118.7772695,"tags":{"artwork_type":"statue","name":"雨花石之歌","tourism":"artwork"}},{"type":"node","id":11909645758,"lat":32.0025572,"lon":118.7782844,"tags":{"historic":"memorial","memorial":"war_memorial","name":"革命烈士殉难处"}},{"type":"node","id":11909645759,"lat":32.0018879,"lon":118.7792094,"tags":{"historic":"tomb","name":"李杰墓"}},{"type":"node","id":11909645760,"lat":32.0010759,"lon":118.7768402,"tags":{"historic":"tomb","name":"知名烈士墓"}},{"type":"node","id":11909645761,"lat":32.0050002,"lon":118.7779135,"tags":{"historic":"tomb","name":"方孝孺墓"}},{"type":"node","id":11909645788,"lat":32.005193,"lon":118.7751784,"tags":{"historic":"tomb","name":"杨邦乂墓"}},{"type":"node","id":11909645808,"lat":32.0016335,"lon":118.7746764,"tags":{"historic":"memorial","memorial":"plaque","name":"国际歌"}},{"type":"node","id":11914751483,"lat":32.0035166,"lon":118.7770286,"tags":{"leisure":"garden","name":"曦园"}},{"type":"node","id":11914758332,"lat":32.0008611,"lon":118.7748708,"tags":{"historic":"memorial","memorial":"plaque","name":"国歌"}},{"type":"node","id":12096679743,"lat":32.0263937,"lon":118.7371136,"tags":{"artwork_type":"sculpture","name":"金属垂柳","tourism":"artwork"}},{"type":"node","id":12325511454,"lat":32.0112937,"lon":118.7770126,"tags":{"historic":"archaeological_site","name":"天王殿遗址"}},{"type":"node","id":12325511455,"lat":32.0114357,"lon":118.7787247,"tags":{"historic":"archaeological_site","name":"伽蓝殿遗址"}},{"type":"node","id":12325511456,"lat":32.0109646,"lon":118.7785935,"tags":{"historic":"archaeological_site","name":"地宫"}},{"type":"node","id":12418195709,"lat":32.0384776,"lon":118.7347573,"tags":{"tourism":"viewpoint"}},{"type":"node","id":12419512857,"lat":31.9891038,"lon":118.7681777,"tags":{"historic":"memorial","inscription":"1937年12月13日南京沦陷后，侵华日军即进行血腥大屠杀，尸横遍地，惨不忍睹。南京红卍字会和崇善堂两慈善团体自1937年12月22日至1938年4月18日止，在中华门外雨花台、望江矶、花神庙一带共掩埋遇难同胞尸体27239具。南京市民芮芳缘、张鸿儒、杨广才等组织难民30余人，于1938年1至2月的40余日内，在花神庙一带掩埋中国军民尸体7000余具，其中难民尸体5000余具，军人尸体2000余具。特立此碑，悼念遇难同胞，永志不忘历史，振兴中华。","memorial":"war_memorial","name":"花神庙地区丛葬地纪念碑","name:en":"Huashen Temple Mass Grave Memorial","name:zh":"花神庙地区丛葬地纪念碑"}},{"type":"node","id":12419513560,"lat":32.0371278,"lon":118.7408275,"tags":{"historic":"memorial","inscription":"一九三七年十二月十六日，日军将已被解除武装之中国士兵和平民万余人，囚禁于原陆军监狱院内，傍晚押至江东门，藉放火焚烧民房照明，骤以轻重机枪向人群猛烈扫射，受害者众声哀号，相继倒卧于血泊之中。遗尸枕藉，盈衡塞道，直至蔽满江东河面，且抛露风日之下，久无人收，情至惨烈。迨逾数月，因天暖尸腐，始由南京慈善团体收尸万余具，掩埋于就近之两大土坑内，故称“万人坑”。爰立此碑。藉志其哀；悼念死者，兼勉后人，热爱祖国，奋发图强，反对侵略战争，维护世界和平。","memorial":"war_memorial","name":"江东门遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Jiangdongmen","name:zh":"江东门遇难同胞纪念碑","start_date":"1985-08-15"}},{"type":"node","id":12419929232,"lat":32.0442059,"lon":118.7599869,"tags":{"historic":"memorial","inscription":"一九三七年十二月十五日下午，避难于国际安全区之本市平民和已解除武装之军警共二千余人，遭日军搜捕后，被押赴汉中门外用机枪扫射杀害，其伤而未死者或乱刀补戳，或纵火活焚，尸骸蔽野，惨绝人寰。至次年二月十一日、十八日两天始由慈善团体南京红卍字会收殓得遗骸共一千三百九十五具，掩埋于汉中门外广东公墓及二道埂子一带。悲夫！今人孰料于此熙来攘往之地曾是往昔日军肆虐之场而有众多同胞罹难于此者乎！爰立此碑以志其事，庶我国人牢记惨史，毋忘国难，居安思危，奋发图强，同心同德，振兴中华。","memorial":"war_memorial","name":"汉中门外遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Hanzhongmen","name:zh":"汉中门外遇难同胞纪念碑","start_date":"1985-08-15"}},{"type":"node","id":12630234629,"lat":32.0024983,"lon":118.7733925,"tags":{"historic":"memorial","name":"革命烈士西殉难处"}},{"type":"node","id":12760290046,"lat":32.0003516,"lon":118.7323932,"tags":{"artwork_type":"statue","name":"陶渊明","tourism":"artwork"}},{"type":"node","id":12856671585,"lat":32.0370046,"lon":118.7386639,"tags":{"historic":"memorial","memorial":"cross"}},{"type":"node","id":12856702936,"lat":32.0371364,"lon":118.7397911,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702937,"lat":32.0371211,"lon":118.7396255,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702938,"lat":32.0371632,"lon":118.7400734,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702939,"lat":32.0371586,"lon":118.7400071,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724011,"lat":32.0371512,"lon":118.739942,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724012,"lat":32.0371302,"lon":118.739708,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724013,"lat":32.0371694,"lon":118.7401351,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724014,"lat":32.0371931,"lon":118.7404258,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724015,"lat":32.0371819,"lon":118.7402934,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724016,"lat":32.0371171,"lon":118.739541,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":13260329001,"lat":32.0389079,"lon":118.7321906,"tags":{"name":"牛啤酒世界精酿啤酒博物馆（建邺吾悦分馆）","name:en":"NIU BEER World Craft Beer Museum (Jianye Wuyue Filiale)","opening_hours":"Mo-Su 16:00-02:00","tourism":"museum"}},{"type":"node","id":13287554383,"lat":32.0024112,"lon":118.7704973,"tags":{"historic":"memorial","memorial":"war_memorial","name":"普德寺丛葬地纪念碑","name:en":"Pude Temple Mass Grave Memorial","name:zh":"普德寺丛葬地纪念碑","start_date":"1985-08-15"}},{"type":"node","id":13287595363,"lat":32.0504266,"lon":118.7676963,"tags":{"historic":"memorial","inscription":"在侵华日军南京大屠杀血腥事件中，五台山一带是我受害同胞尸骨丛葬地之一。据崇善堂、红卍字会等慈善团体埋尸记录记载，于一九三七年十二月至一九三八年二月，曾在此先后四批埋葬。我被害同胞尸骨二百五十四具。特立此碑，以志悼念。","memorial":"war_memorial","name":"五台山丛葬地纪念碑","name:zh":"五台山丛葬地纪念碑","start_date":"1987-12-13"}},{"type":"node","id":13540522849,"lat":32.0515055,"lon":118.7562351,"tags":{"amenity":"place_of_worship","name":"清凉寺","religion":"buddhist"}},{"type":"node","id":13719014040