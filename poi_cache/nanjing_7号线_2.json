imedia_commons":"Category:Family Ruined"}},{"type":"node","id":9459587275,"lat":31.9406481,"lon":118.678565,"tags":{"historic":"ruins","name":"姚南村明墓石刻"}},{"type":"node","id":9459766134,"lat":32.0352499,"lon":118.754972,"tags":{"artwork_type":"sculpture","name":"福禄童戏","tourism":"artwork"}},{"type":"node","id":9459766135,"lat":32.0358284,"lon":118.7545594,"tags":{"artwork_type":"sculpture","name":"雅艺·投壶","tourism":"artwork"}},{"type":"node","id":9459766137,"lat":32.0370467,"lon":118.7527853,"tags":{"artwork_type":"sculpture","name":"雅艺·锤丸雕塑","tourism":"artwork"}},{"type":"node","id":9899007105,"lat":32.0103024,"lon":118.7005682,"tags":{"historic":"memorial","memorial":"war_memorial","name":"上新河地区遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Shangxinhe","name:zh":"上新河地区遇难同胞纪念碑"}},{"type":"node","id":11656779069,"lat":32.049575,"lon":118.7523341,"tags":{"name":"南京城墙清凉门","tourism":"artwork"}},{"type":"node","id":12096679743,"lat":32.0263937,"lon":118.7371136,"tags":{"artwork_type":"sculpture","name":"金属垂柳","tourism":"artwork"}},{"type":"node","id":12418195709,"lat":32.0384776,"lon":118.7347573,"tags":{"tourism":"viewpoint"}},{"type":"node","id":12419513560,"lat":32.0371278,"lon":118.7408275,"tags":{"historic":"memorial","inscription":"一九三七年十二月十六日，日军将已被解除武装之中国士兵和平民万余人，囚禁于原陆军监狱院内，傍晚押至江东门，藉放火焚烧民房照明，骤以轻重机枪向人群猛烈扫射，受害者众声哀号，相继倒卧于血泊之中。遗尸枕藉，盈衡塞道，直至蔽满江东河面，且抛露风日之下，久无人收，情至惨烈。迨逾数月，因天暖尸腐，始由南京慈善团体收尸万余具，掩埋于就近之两大土坑内，故称“万人坑”。爰立此碑。藉志其哀；悼念死者，兼勉后人，热爱祖国，奋发图强，反对侵略战争，维护世界和平。","memorial":"war_memorial","name":"江东门遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Jiangdongmen","name:zh":"江东门遇难同胞纪念碑","start_date":"1985-08-15"}},{"type":"node","id":12419929232,"lat":32.0442059,"lon":118.7599869,"tags":{"historic":"memorial","inscription":"一九三七年十二月十五日下午，避难于国际安全区之本市平民和已解除武装之军警共二千余人，遭日军搜捕后，被押赴汉中门外用机枪扫射杀害，其伤而未死者或乱刀补戳，或纵火活焚，尸骸蔽野，惨绝人寰。至次年二月十一日、十八日两天始由慈善团体南京红卍字会收殓得遗骸共一千三百九十五具，掩埋于汉中门外广东公墓及二道埂子一带。悲夫！今人孰料于此熙来攘往之地曾是往昔日军肆虐之场而有众多同胞罹难于此者乎！爰立此碑以志其事，庶我国人牢记惨史，毋忘国难，居安思危，奋发图强，同心同德，振兴中华。","memorial":"war_memorial","name":"汉中门外遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Hanzhongmen","name:zh":"汉中门外遇难同胞纪念碑","start_date":"1985-08-15"}},{"type":"node","id":12760290046,"lat":32.0003516,"lon":118.7323932,"tags":{"artwork_type":"statue","name":"陶渊明","tourism":"artwork"}},{"type":"node","id":12856671585,"lat":32.0370046,"lon":118.7386639,"tags":{"historic":"memorial","memorial":"cross"}},{"type":"node","id":12856702936,"lat":32.0371364,"lon":118.7397911,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702937,"lat":32.0371211,"lon":118.7396255,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702938,"lat":32.0371632,"lon":118.7400734,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856702939,"lat":32.0371586,"lon":118.7400071,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724011,"lat":32.0371512,"lon":118.739942,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724012,"lat":32.0371302,"lon":118.739708,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724013,"lat":32.0371694,"lon":118.7401351,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724014,"lat":32.0371931,"lon":118.7404258,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724015,"lat":32.0371819,"lon":118.7402934,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":12856724016,"lat":32.0371171,"lon":118.739541,"tags":{"artwork_type":"sculpture","tourism":"artwork"}},{"type":"node","id":13260329001,"lat":32.0389079,"lon":118.7321906,"tags":{"name":"牛啤酒世界精酿啤酒博物馆（建邺吾悦分馆）","name:en":"NIU BEER World Craft Beer Museum (Jianye Wuyue Filiale)","opening_hours":"Mo-Su 16:00-02:00","tourism":"museum"}},{"type":"node","id":13719014040,"lat":32.0212,"lon":118.7632147,"tags":{"historic":"city_gate","name":"集庆门"}},{"type":"way","id":