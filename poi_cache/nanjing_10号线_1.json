ism":"artwork"}},{"type":"node","id":9459766135,"lat":32.0358284,"lon":118.7545594,"tags":{"artwork_type":"sculpture","name":"雅艺·投壶","tourism":"artwork"}},{"type":"node","id":9459766137,"lat":32.0370467,"lon":118.7527853,"tags":{"artwork_type":"sculpture","name":"雅艺·锤丸雕塑","tourism":"artwork"}},{"type":"node","id":9899007105,"lat":32.0103024,"lon":118.7005682,"tags":{"historic":"memorial","memorial":"war_memorial","name":"上新河地区遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Shangxinhe","name:zh":"上新河地区遇难同胞纪念碑"}},{"type":"node","id":12096679743,"lat":32.0263937,"lon":118.7371136,"tags":{"artwork_type":"sculpture","name":"金属垂柳","tourism":"artwork"}},{"type":"node","id":12418195709,"lat":32.0384776,"lon":118.7347573,"tags":{"tourism":"viewpoint"}},{"type":"node","id":12419512857,"lat":31.9891038,"lon":118.7681777,"tags":{"historic":"memorial","inscription":"1937年12月13日南京沦陷后，侵华日军即进行血腥大屠杀，尸横遍地，惨不忍睹。南京红卍字会和崇善堂两慈善团体自1937年12月22日至1938年4月18日止，在中华门外雨花台、望江矶、花神庙一带共掩埋遇难同胞尸体27239具。南京市民芮芳缘、张鸿儒、杨广才等组织难民30余人，于1938年1至2月的40余日内，在花神庙一带掩埋中国军民尸体7000余具，其中难民尸体5000余具，军人尸体2000余具。特立此碑，悼念遇难同胞，永志不忘历史，振兴中华。","memorial":"war_memorial","name":"花神庙地区丛葬地纪念碑","name:en":"Huashen Temple Mass Grave Memorial","name:zh":"花神庙地区丛葬地纪念碑"}},{"type":"node","id":12419513560,"lat":32.0371278,"lon":118.7408275,"tags":{"historic":"memorial","inscription":"一九三七年十二月十六日，日军将已被解除武装之中国士兵和平民万余人，囚禁于原陆军监狱院内，傍晚押至江东门，藉放火焚烧民房照明，骤以轻重机枪向人群猛烈扫射，受害者众声哀号，相继倒卧于血泊之中。遗尸枕藉，盈衡塞道，直至蔽满江东河面，且抛露风日之下，久无人收，情至惨烈。迨逾数月，因天暖尸腐，始由南京慈善团体收尸万余具，掩埋于就近之两大土坑内，故称“万人坑”。爰立此碑。藉志其哀；悼念死者，兼勉后人，热爱祖国，奋发图强，反对侵略战争，维护世界和平。","memorial":"war_memorial","name":"江东门遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Jiangdongmen","name:zh":"江东门遇难同胞纪念碑","start_date":"1985-08-15"}},{"type":"node","id":12760290046,"lat":32.0003516,"lon":118.7323932,"tags":{"artwork_type":"statue","name":"陶渊明","tourism":"artwork"}},{"type":"node","id":12856671585,"lat":32.0370046,"lon":118.7386639,"tags":{"historic":"memorial","memorial":"cross"}},{"type":"node","id":12856702936