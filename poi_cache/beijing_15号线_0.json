"lon":116.3369534},"tags":{"leisure":"park","name":"王庄公园（西区）","name:zh":"王庄公园（西区）","name:zh-Hans":"王庄公园（西区）","name:zh-Hant":"王莊公園（西區）"}},{"type":"way","id":1044616164,"center":{"lat":39.9991748,"lon":116.3408649},"tags":{"leisure":"park","name":"王庄公园（东区）","name:zh":"王庄公园（东区）","name:zh-Hans":"王庄公园（东区）","name:zh-Hant":"王莊公園（東區）"}},{"type":"way","id":1047004211,"center":{"lat":40.009434,"lon":116.3973374},"tags":{"leisure":"park","name":"紫玉山庄西区"}},{"type":"way","id":1052622338,"center":{"lat":39.9910189,"lon":116.3784137},"tags":{"leisure":"park","name":"老故事503文创园"}},{"type":"way","id":1056034695,"center":{"lat":40.0073019,"lon":116.3337983},"tags":{"amenity":"place_of_worship","building":"yes","description":"延寿寺位于东升镇前八家村，中国科学院生态环境研究中心西侧，双清大厦北面。现存的古建只有山门殿三间，坐南朝北，硬山筒瓦过垅脊。这座庙建于清康熙年间，是村庙，由合村公建。1928年时，有房殿21间，庙内有弥勒佛、十八罗汉、三大士、真武、四大天王、韦驮、四位娘娘、药王、土地、五道阎君等塑像，有铁磬六口。解放后一直被用作前八家小学直至2010年全村拆迁。山门殿北侧原有大殿及配殿，大殿后面为后罩房，院内有夹杆石，后罩房在1958年被拆，夹杆石在1966年被运走，大殿东北处有青砖和尚塔一座，“文革”初期被拆。","name":"延寿寺","name:zh":"延寿寺","name:zh-Hans":"延寿寺","name:zh-Hant":"延壽寺","religion":"buddhist"}},{"type":"way","id":1060959369,"center":{"lat":40.0043798,"lon":116.3230511},"tags":{"access":"private","leisure":"garden","operator":"清华大学","operator:type":"government"}},{"type":"way","id":1091829946,"center":{"lat":40.0100579,"lon":116.3245873},"tags":{"access":"yes","fee":"no","garden:type":"community","leisure":"garden","name":"小花园","name:zh":"小花园","name:zh-Hans":"小花园","name:zh-Hant":"小花園","operator":"清华大学","operator:type":"public"}},{"type":"way","id":1127819777,"center":{"lat":39.989142,"lon":116.3902884},"tags":{"building":"yes","fee":"no","name":"北京奥运博物馆","name:en":"Beijing Olympic Museum","phone":"+86 10 8437 8778","tourism":"museum","website":"https://www.bjaybwg.com/"}},{"type":"way","id":1150992484,"center":{"lat":40.0132352,"lon":116.3500447},"tags":{"leisure":"park"}},{"type":"way","id":1166085712,"center":{"lat":40.0027805,"lon":116.322746},"tags":{"leisure":"park","name":"0304广场"}},{"type":"way","id":117213