{"version":0.6,"generator":"Overpass API 0.7.62.11 87bfad18","osm3s":{"timestamp_osm_base":"2026-07-15T15:22:01Z","copyright":"The data included in this document is from www.openstreetmap.org. The data is made available under ODbL."},"elements":[{"type":"node","id":5659706298,"lat":32.1769611,"lon":118.702962,"tags":{"leisure":"park","name":"明湖"}},{"type":"node","id":9830557107,"lat":32.1405521,"lon":118.6994387,"tags":{"historic":"ruins","name":"浦口明城墙遗址"}},{"type":"node","id":10196551771,"lat":32.2059812,"lon":118.717379,"tags":{"artwork_type":"statue","material":"stone","name":"涂长望先生像","tourism":"artwork"}},{"type":"node","id":10196551772,"lat":32.2058241,"lon":118.7135088,"tags":{"artwork_type":"statue","material":"stone","name":"竺可桢先生像","tourism":"artwork"}},{"type":"node","id":13287554387,"lat":32.1194384,"lon":118.7589549,"tags":{"historic":"memorial","inscription":"一九三七年十二月十五日夜，侵华日军将被其搜捕之我市平民和已解除武装之守城官兵九千余人，押至鱼雷营，以机枪集体射杀。同月，日军又在鱼雷营、宝塔桥一带再次杀害我军民三万余人。死难者之遗骸，直至次年二月，犹曝露于军营码头等地，惨不可睹。后由红卍字会就地掩埋，仅二月十九日、二十一日、二十二日三天，埋尸即达五千余具。惨史难忘，忆往志慨，特立此碑，正告方来。","memorial":"war_memorial","name":"鱼雷营遇难同胞纪念碑","name:en":"Memorial to the Fallen Compatriots in Yuleiying","name:zh":"鱼雷营遇难同胞纪念碑"}},{"type":"node","id":13691945295,"lat":32.1906022,"lon":118.758783,"tags":{"artwork_type":"statue","tourism":"artwork"}},{"type":"way","id":93553452,"center":{"lat":32.2211158,"lon":118.7491497},"tags":{"leisure":"park","name":"太子山公园"}},{"type":"way","id":337283583,"center":{"lat":32.1391663,"lon":118.7410443},"tags":{"leisure":"park"}},{"type":"way","id":337283585,"center":{"lat":32.1404436,"lon":118.7414841},"tags":{"leisure":"park"}},{"type":"way","id":337283586,"center":{"lat":32.1399076,"lon":118.7412883},"tags":{"leisure":"park"}},{"type":"way","id":337283587,"center":{"lat":32.1395103,"lon":118.741212},"tags":{"leisure":"park"}},{"type":"way","id":360087878,"center":{"lat":32.1517188,"lon":118.7259038},"tags":{"leisure":"park"}},{"type":"way","id":360088019,"center":{"lat":32.1479427,"lon":1